# Build and validation by-products
.codex-build/
.codex-finalizer-*/
**/__pycache__/
*.pyc
*.log

# Credentials and participant identity
기획서/team_info.json
.env
.env.*
!*.example

# Generated submission binaries are uploaded separately
*.pptx
*.pdf
*.webm
*.zip

# Historical local-model experiments are not part of the public repository
mvp/data/*ollama*
mvp/data/benchmark_reproducibility_summary_*.json
mvp/data/ui_run_results_2026-11-06.json

# Keep one current release notice; older documents describe superseded builds
mvp/RELEASE_MANIFEST_v0.*.md
!mvp/RELEASE_MANIFEST_v0.9.0.md
!mvp/RELEASE_MANIFEST_v0.9.1.md
!mvp/RELEASE_MANIFEST_v0.9.2.md
